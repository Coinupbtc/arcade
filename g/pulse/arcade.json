{
  "id": "pulse",
  "title": "PULSE",
  "tagline": "Four lanes, one thumb. The chart is the music — no song files.",
  "description": "A four-lane rhythm game with no song files: every track is synthesised in your browser, and the falling notes come from the same event list that plays the audio, so a note cannot drift from the beat. Tap a lane when a bar crosses the line; timing decides perfect/good/ok/miss and an unbroken chain raises the multiplier. Long bars are holds: stay down to the tail for 150 points, a perfect note of accuracy and a FLOW refill. Every miss drains FLOW and at zero the run ends; if your played accuracy stays under the 60% clear line, the run ends too, so mashing cannot reach the end. Eight tracks rise from drift to pressure, each with a saved best, a medal and a clear mark.",
  "genre": "Rhythm",
  "tags": [
    "rhythm",
    "music",
    "timing",
    "arcade"
  ],
  "orientation": "any",
  "realtime": true,
  "session": "1–2 min",
  "controls": {
    "desktop": [
      [
        "D F J K / Arrows",
        "Tap the lane"
      ],
      [
        "LMB",
        "Tap the lane under the pointer"
      ],
      [
        "Enter / Space",
        "Start the chosen track"
      ],
      [
        "Arrows / W S",
        "Choose a track, or a button on pause and results"
      ],
      [
        "A D / Arrow Left Right",
        "Change SPEED or OFFSET when its chip is focused"
      ],
      [
        "Esc / P",
        "Pause and resume"
      ]
    ],
    "touch": [
      [
        "Tap",
        "Tap a lane (each column is a quarter of the screen)"
      ],
      [
        "Hold",
        "Hold a long bar to its tail"
      ],
      [
        "Tap a track",
        "Choose it — PLAY (bottom bar) starts it"
      ],
      [
        "Tap SPEED / OFFSET",
        "Cycle speed, or tap calibration offset"
      ],
      [
        "Tap ⏸",
        "Pause, then RESUME"
      ]
    ],
    "gamepad": [
      [
        "A B X Y / DPad",
        "Tap the lane"
      ],
      [
        "A / Start",
        "Start the chosen track"
      ],
      [
        "DPad / LS up-down",
        "Choose a track, or a button on pause and results"
      ],
      [
        "DPad ◀ ▶ / LS ◀ ▶",
        "Change SPEED or OFFSET when its chip is focused"
      ],
      [
        "Start",
        "Pause and resume"
      ],
      [
        "B",
        "Back to the track list from pause or results (lane 2 while playing)"
      ]
    ]
  },
