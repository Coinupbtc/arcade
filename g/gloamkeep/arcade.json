{
  "id": "gloamkeep",
  "title": "Gloamkeep",
  "tagline": "Build lantern towers on the moor, flare the keep's light, hold the causeway.",
  "description": "A small pixel tower defence on a black peat moor. Tap a tower button, then tap a tile beside the causeway. Every tower has two fire modes, so one lantern can bolt a single foe or flare a crowd. Kills in a row heat the keep: the lantern gauge fills, and a hot keep recharges FLARE faster. In a wave, tap FLARE to mark every foe: a marked foe loses its armour, and an unmarked Gloam Sovereign shrugs off most damage, so save it for the armoured push. Between waves spend embers on towers or four upgrade levels. The last waves bring flying shades, knights, brutes and two Sovereigns. If the light hits zero the keep goes dark.",
  "genre": "Tower defence",
  "tags": [
    "strategy",
    "defence",
    "pixel"
  ],
  "orientation": "any",
  "realtime": true,
  "session": "8 min",
  "controls": {
    "desktop": [
      [
        "W A S D / Arrows",
        "Move the tile cursor"
      ],
      [
        "Enter",
        "Build at the cursor, inspect a tower"
      ],
      [
        "Space",
        "Send the next wave early, or flare the lantern while a wave runs"
      ],
      [
        "1 2 3 4",
        "Pick Ember / Cinder / Frost / Arc"
      ],
      [
        "LMB",
        "Tap a tile or a button"
      ],
      [
        "RMB / Backspace",
        "Cancel the armed build, close the sheet"
      ],
      [
        "X / Shift",
        "Switch the tower's fire mode"
      ],
      [
        "E",
        "Upgrade the selected tower"
      ],
      [
        "T",
        "Cycle target priority"
      ],
      [
        "F",
        "Speed 1x / 2x"
      ],
      [
        "Esc / P",
        "Pause"
      ]
    ],
    "touch": [
      [
        "Tap",
        "Pick a tower or tap a moor tile to build"
      ],
      [
        "Tap tower",
        "Open its sheet: mode, upgrade, sell"
      ],
      [
        "Tap FLARE",
        "In a wave: mark every foe (strips armour)"
      ],
      [
        "Button",
        "Pause, top right"
      ]
    ],
    "gamepad": [
      [
        "LT / RT",
        "Pick the previous / next tower"
      ],
      [
        "LS / DPad",
        "Move the tile cursor"
      ],
      [
        "A",
        "Build at the cursor, inspect a tower"
      ],
      [
        "RB",
        "Send the next wave early, or flare the lantern while a wave runs"
      ],
      [
        "B",
        "Cancel the armed build, close the sheet"
      ],
      [
        "X",
        "Switch fire mode"
      ],
      [
        "Y",
        "Upgrade"
      ],
      [
        "LB",
        "Cycle target priority"
      ],
      [
        "BACK",
        "Speed 1x / 2x"
      ],
      [
        "Start",
        "Pause"
      ]
    ]
  },
